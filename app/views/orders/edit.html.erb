<div class="max-w-4xl p-6">

  <h1 class="text-4xl font-bold mb-6">
    Editing order
  </h1>

  <%= form_with model: @order do |form| %>

    <% if @order.errors.any? %>
      <div class="mb-6 text-red-600">
        <h2 class="font-bold">
          <%= pluralize(@order.errors.count, "error") %> prevented this order from being saved:
        </h2>

        <ul class="list-disc ml-6">
          <% @order.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-6">
      <%= form.label :name, class: "block mb-2" %>
      <%= form.text_field :name,
          class: "w-full border border-gray-400 rounded-md px-3 py-2 shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>

    <div class="mb-6">
      <%= form.label :address, class: "block mb-2" %>
      <%= form.text_area :address, rows: 5,
          class: "w-full border border-gray-400 rounded-md px-3 py-2 shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>

    <div class="mb-6">
      <%= form.label :email, class: "block mb-2" %>
      <%= form.email_field :email,
          class: "w-full border border-gray-400 rounded-md px-3 py-2 shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>

    <div class="mb-6">
      <%= form.label :pay_type, "Payment Type", class: "block mb-2" %>
      <%= form.select :pay_type,
          Order.pay_types.keys.map { |type| [type.humanize, type] },
          {},
          class: "w-full border border-gray-400 rounded-md px-3 py-2 shadow-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>

    <div class="mb-6">
      <%= form.label :ship_date, "Ship Date", class: "block mb-2" %>
      <%= form.date_field :ship_date,
          class: "w-full border border-gray-400 rounded-md px-3 py-2 shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>

    <div class="mb-6">
      <%= form.submit "Update Order",
          class: "bg-green-700 text-white px-5 py-2 rounded-md hover:bg-green-800 cursor-pointer" %>
    </div>

  <% end %>

  <%= link_to "Back to Orders", orders_path,
      class: "text-blue-700 hover:underline" %>

</div>