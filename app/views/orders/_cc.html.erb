<fieldset data-payment-target="additionalFields" data-type="Credit Card">
  <div class="my-5">
    <%= form.label :card_no, t('.cc_number') %>
    <%= form.password_field :card_no, class: "input-field" %>
  </div>
  <div class="my-5">
    <%= form.label :expiration_date, t('.expiration_date') %>
    <%= form.text_field :expiration_date, class: "input-field", size:9, placeholder: "e.g. 03/22" %>
  </div>
</fieldset>