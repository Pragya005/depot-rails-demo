<% if line_item == @current_item %>
<tr class="line-item-highlight">
<% else %>
<tr>
<% end%>
  <td class="text-right"><%= line_item.quantity %></td>
  <td>&times;</td>
  <td class="pr-2">
    <%= line_item.product.title %>
  </td>
  <td class="text-right font-bold">
    <%= number_to_currency(line_item.total_price) %>
  </td>
</tr>
<tr>
  <td> <%= button_to "+", line_item_path(id: line_item.id, amount: 1), method: :patch, class: "cursor-pointer bg-green-600 text-white rounded px-3 py-1" %> </td>
  <td> <%= button_to "-", line_item_path(id: line_item.id, amount: -1), method: :patch, class: "cursor-pointer bg-red-600 text-white rounded px-3 py-1" %> </td>
</tr>
