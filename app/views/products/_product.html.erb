<div id="<%= dom_id product %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Title:</strong>
    <%= product.title %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Description:</strong>
    <%= product.description %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Image:</strong>
    <%= link_to product.image.filename, product.image, class: "text-gray-700 underline hover:no-underline" if product.image.attached? %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Price:</strong>
    <%= product.price %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Locale:</strong>
      <%= product.locale %>
  </div>
  <% unless product.enabled.nil? %>
    <div>
      <strong class="block font-medium mb-1">Enabled</strong>
        <%= product.enabled %>
    </div>
  <% end %>

  <% if product.discount_price %>
    <div>
      <strong class="block font-medium mb-1">Discounted Price</strong>
        <%= product.discount_price %>
    </div>
  <% end %>
  <% if product.permalink %>
    <div>
      <strong class="block font-medium mb-1">Permalink</strong>
        <%= product.permalink %>
    </div>
  <% end %>
</div>
